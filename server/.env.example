# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the blanks. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database --------------------------------------------------------------
# Local install:  mongodb://127.0.0.1:27017/nirapod
# Atlas M0 (free forever): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nirapod
MONGO_URI=mongodb://127.0.0.1:27017/nirapod

# --- Auth ------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# --- Client ----------------------------------------------------------------
# Used for links inside emails (tracking pages, password resets) and CORS.
# This is the origin the SOS tracking link and password reset link point at,
# so it has to be an address the recipient can actually open.
CLIENT_URL=http://localhost:5173
# Comma separated list if you serve the client from more than one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (free options) --------------------------------------------------
# MAIL_TRANSPORT = smtp | ethereal | console
#   smtp     -> real delivery. Gmail: enable 2FA, then create an "App password".
#               Brevo free tier gives 300 mails/day: smtp-relay.brevo.com:587
#   ethereal -> auto-creates a throwaway inbox and prints a preview URL. Great for dev.
#   console  -> just logs the message. Used by the test suite.
MAIL_TRANSPORT=ethereal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Nirapod Safety
MAIL_FROM_ADDRESS=no-reply@nirapod.app

# --- Uploads ---------------------------------------------------------------
# Files are written here and served from /uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# --- Outbound geo services (both free, no key required) --------------------
# Nominatim asks for a contact address in the User-Agent. Put yours here.
GEO_USER_AGENT=Nirapod/1.0 (contact: admin@nirapod.app)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter


# --- Bootstrap admin (used by `npm run seed`) ------------------------------
SEED_ADMIN_EMAIL=admin@nirapod.app
SEED_ADMIN_PASSWORD=Admin@12345
